    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
